<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="design1">
    <Sequence>
      <StringTopicToBB out_key="{msg_string}"/>
      <Log in_string="{msg_string}"/>
      <BBToStringTopic in_key="{msg_string}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="design2">
    <StandaloneSubPub in_msg="CATS"/>
  </BehaviorTree>

  <BehaviorTree ID="main_tree">
    <KeepRunningUntilFailure>
      <Sequence>
        <SubTree ID="design1"
                 _autoremap="true"/>
        <SubTree ID="design2"
                 _autoremap="true"/>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BBToStringTopic">
      <input_port name="in_key"
                  type="std::shared_ptr&lt;std_msgs::String_&lt;std::allocator&lt;void&gt; &gt; &gt;"/>
    </Action>
    <Action ID="Log">
      <input_port name="in_string"
                  type="std::shared_ptr&lt;std_msgs::String_&lt;std::allocator&lt;void&gt; &gt; &gt;"/>
    </Action>
    <Action ID="StandaloneSubPub">
      <input_port name="in_msg"
                  type="std::string"/>
    </Action>
    <Action ID="StringTopicToBB">
      <output_port name="out_key"
                   type="std::shared_ptr&lt;std_msgs::String_&lt;std::allocator&lt;void&gt; &gt; &gt;"/>
    </Action>
  </TreeNodesModel>

</root>
