<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="main_tree">
    <Sequence>
      <StringTopicToBT ros_topic="{msg}"/>
      <Logger ros_topic="{msg}"/>
      <BTToStringTopic ros_topic="{msg}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="BTToStringTopic"
            editable="true">
      <input_port name="ros_topic"/>
    </Action>
    <Action ID="Logger"
            editable="true">
      <input_port name="ros_topic"/>
    </Action>
    <Action ID="StringTopicToBT"
            editable="true">
      <output_port name="ros_topic"/>
    </Action>
  </TreeNodesModel>

</root>
